{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccSwitch",
  "version": "2026.11.111528",
  "identifier": "com.qiuyongjun.accswitch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AccSwitch",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "qiuyongjun",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNzYwODM5M0UyRkE5MzAKUldRd3FTOCtPUWgya2Vsc2pQQmlVSjRSNTRqdVpsM2MzOGVLRVNNakhKeG1aTGh2VGtyOEEreGMK",
      "endpoints": [
        "https://github.com/qiuyongjun/AccSwitch/releases/latest/download/latest.json",
        "https://github.com/qiuyongjun/AccSwitch/releases/latest/download/latest-{{target}}-{{arch}}.json",
        "https://github.com/qiuyongjun/AccSwitch/releases/latest/download/latest-macos-{{arch}}.json"
      ]
    }
  }
}
